CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- PSRAM Configuration ---------------------------------------------
# Enable PSRAM to allow ESP-SR Audio Front-End (AFE) Neural Noise Suppression
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y

# --- WakeNet & AFE (esp-sr) -------------------------------------------
# Enable AFE/WakeNet neural speech recognition
CONFIG_APP_USE_ESP_SR=y

# WakeNet model selection
CONFIG_SR_WN_WN9_ALEXA=y

# Enable WebRTC Noise Suppression & Voice Activity Detection
CONFIG_SR_NSN_WEBRTC=y
CONFIG_SR_VADN_WEBRTC=y
CONFIG_APP_WAKENET_USE_NS=y

# Model partition in flash mmap
CONFIG_MODEL_IN_FLASH=y

# --- Logging ---------------------------------------------------------
# CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y

