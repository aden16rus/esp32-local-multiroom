# =============================================================================
# Local Voice Control System Central Server Environment Configuration
# =============================================================================

# Central Voice Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8765
LOG_LEVEL=INFO
LOG_FILE=logs/server.log

# Home Assistant Connection Settings
HA_URL=http://localhost:8123
HA_TOKEN=your_long_lived_access_token_here
HA_TIMEOUT=5.0

# Multi-Room Arbitration Settings
ARBITER_WINDOW_MS=250.0

# Audio Processing & VAD Settings
AUDIO_SAMPLE_RATE=16000
VAD_SILENCE_MS=600
VAD_THRESHOLD=0.5
AGC_TARGET_RMS=3500.0

# Text-to-Speech & Speech-to-Text Settings
TTS_VOICE=ru_RU-iryna-medium
# STT_MODEL_PATH=models/sherpa-onnx-nemo-transducer-giga-am-v2-russian-2025-04-19

